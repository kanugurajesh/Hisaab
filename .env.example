DATABASE_URL="postgresql://choruss:choruss@localhost:5432/choruss?schema=public"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Enables a passwordless "demo organizer" login. Never enable in production.
DEMO_LOGIN="true"

# Groq
GROQ_API_KEY=""
GROQ_TEXT_MODEL="openai/gpt-oss-120b"
GROQ_VISION_MODEL="qwen/qwen3.8-27b"
# Set to "true" to use deterministic fake AI responses (tests, offline demos)
AI_MOCK="false"

# Storage: "local" (./uploads) or "gcs"
STORAGE_DRIVER="local"
GCS_BUCKET=""

APP_URL="http://localhost:3000"
